# flomo-insight configuration
# Copy this file to config.toml and fill in your tokens:
#   cp config.toml.example config.toml

# flomo API token — Chrome F12 → Network → /api/ → Authorization → value after "Bearer "
flomo_token = ""

# WeRead Skills API key — https://weread.qq.com/r/weread-skills (optional)
weread_key = ""

# Database path
db_path = "data/flomo.db"
