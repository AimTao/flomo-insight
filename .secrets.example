# flomo-insight secrets
# Copy to: ~/.local/share/flomo-insight/.secrets
# Then fill in your token and chmod 600

# flomo Bearer token — Chrome → F12 → Network → any /api/ request → Authorization → copy the value after "Bearer "
flomo_token = ""

# WeRead API key — https://weread.qq.com/r/weread-skills (optional)
weread_key = ""
